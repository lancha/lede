#!/bin/sh

uci -q batch <<-EOF
	set network.lan.proto='static'
	set network.lan.ipaddr='192.168.0.188'
	set network.lan.netmask='255.255.255.0'
	set network.lan.gateway='192.168.0.195'
	set network.lan.dns='192.168.0.195'
	set dhcp.lan.ignore='1'
	set luci.main.mediaurlbase='/luci-static/neobird'
	set luci.themes.Neobird='/luci-static/neobird'
	commit network
	commit dhcp
	commit luci
EOF

/etc/init.d/openclash disable 2>/dev/null || true
exit 0
